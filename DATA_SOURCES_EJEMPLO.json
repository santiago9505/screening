      "descripcion": "Precio de apertura del día",
      "fuente": "meta.regularMarketOpen",
      "ejemplo": 267.50
    },
    "volume": {
      "tipo": "number",
      "descripcion": "Volumen de acciones negociadas",
      "fuente": "meta.regularMarketVolume",
      "ejemplo": 45140079
    },
    "marketCap": {
      "tipo": "number",
      "descripcion": "Capitalización de mercado en USD",
      "fuente": "meta.marketCap (si disponible, sino estimado)",
      "ejemplo": 4067000000000
    },
    "sma20": {
      "tipo": "number",
      "descripcion": "Media móvil simple de 20 días",
      "estado": "NO CALCULADA (siempre retorna 0)",
      "ejemplo": 0
    },
    "sma50": {
      "tipo": "number",
      "descripcion": "Media móvil simple de 50 días",
      "calculo": "Promedio de últimos 50 precios de cierre",
      "ejemplo": 251.34
    },
    "sma150": {
      "tipo": "number",
      "descripcion": "Media móvil simple de 150 días",
      "calculo": "Promedio de últimos 150 precios o (SMA50 + SMA200) / 2",
      "ejemplo": 245.67
    },
    "sma200": {
      "tipo": "number",
      "descripcion": "Media móvil simple de 200 días",
      "calculo": "Promedio de últimos 200 precios de cierre",
      "ejemplo": 232.89
    },
    "ema20": {
      "tipo": "number",
      "descripcion": "Media móvil exponencial de 20 días",
      "estado": "NO CALCULADA (siempre retorna 0)",
      "ejemplo": 0
    },
    "ema50": {
      "tipo": "number",
      "descripcion": "Media móvil exponencial de 50 días",
      "estado": "NO CALCULADA (siempre retorna 0)",
      "ejemplo": 0
    },
    "relativeStrength": {
      "tipo": "number",
      "descripcion": "Fuerza relativa normalizada 0-100",
      "calculo": "Basado en changePercent, normalizado entre 0-100",
      "ejemplo": 48
    },
    "lastUpdate": {
      "tipo": "string (ISO 8601)",
      "descripcion": "Timestamp de última actualización",
      "ejemplo": "2025-11-08T00:00:00.000Z"
    }
  },
