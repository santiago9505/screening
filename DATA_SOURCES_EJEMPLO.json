      ]
    }
  },
  "TRANSFORMACION_SERVIDOR": {
    "descripcion": "Cómo el servidor transforma los datos de Yahoo Finance",
    "pasos": [
      "1. Obtiene meta.regularMarketPrice como 'price'",
      "2. Obtiene meta.chartPreviousClose como 'prevClose'",
      "3. Calcula changePercent: ((price - prevClose) / prevClose) * 100",
      "4. Extrae indicators.quote[0].close (array de ~250 precios)",
      "5. Calcula SMA50: promedio de últimos 50 valores del array",
      "6. Calcula SMA200: promedio de últimos 200 valores del array",
      "7. Calcula SMA150: promedio de últimos 150 o (SMA50 + SMA200) / 2",
      "8. Busca nombre en all-us-stocks.json usando getStockName(symbol)",
      "9. Calcula relativeStrength: normalización de changePercent entre 0-100",
      "10. Retorna objeto completo con todos los campos"
    ]
  },
  "CAMPOS_RETORNADOS": {
    "symbol": {
      "tipo": "string",
      "descripcion": "Ticker de la acción",
      "ejemplo": "AAPL"
    },
    "name": {
      "tipo": "string",
      "descripcion": "Nombre completo de la empresa (desde all-us-stocks.json)",
      "ejemplo": "Apple Inc."
    },
    "price": {
      "tipo": "number",
      "descripcion": "Precio actual del mercado en USD",
      "fuente": "meta.regularMarketPrice",
      "ejemplo": 268.47
    },
    "prevClose": {
      "tipo": "number",
      "descripcion": "Precio de cierre del día anterior",
      "fuente": "meta.chartPreviousClose",
      "ejemplo": 269.77
    },
    "changePercent": {
      "tipo": "number",
      "descripcion": "Cambio porcentual vs cierre anterior",
      "calculo": "((price - prevClose) / prevClose) * 100",
      "ejemplo": -0.48
    },
    "high": {
      "tipo": "number",
      "descripcion": "Precio máximo del día",
      "fuente": "meta.regularMarketDayHigh",
