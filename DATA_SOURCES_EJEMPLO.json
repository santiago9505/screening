    "indicators": {
      "quote": [
        {
          "descripcion": "Cada array contiene ~250 valores (1 año de datos diarios)",
          "close": "Array de precios de cierre: [223.45, 224.12, 225.89, ..., 268.47]",
          "high": "Array de máximos diarios: [224.50, 225.30, 227.00, ..., 272.29]",
          "low": "Array de mínimos diarios: [222.10, 223.50, 225.00, ..., 266.78]",
          "open": "Array de aperturas: [223.50, 224.00, 226.00, ..., 267.50]",
          "volume": "Array de volúmenes: [52000000, 48000000, ..., 45140079]",
