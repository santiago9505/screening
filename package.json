{
  "name": "stock-screener-pro",
  "private": true,
  "version": "1.0.0",
  "description": "Aplicación profesional para análisis de acciones en tiempo real con datos de TradingView",
  "author": "Santiago",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "test": "node --test test/*.test.js",
    "test:fundamentals": "node --test test/fundamentals-parser.test.js",
    "test:rs": "node --test test/rs-rating.test.js",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development concurrently \"npm run server\" \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.stockscreener.pro",
    "productName": "Stock Screener Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "all-us-stocks.json",
      "icon.png",
      "icon.ico",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@types/react-window": "^1.8.8",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "date-fns": "^2.30.0",
    "express": "^4.21.2",
    "lucide-react": "^0.294.0",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^2.2.3",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^39.1.2",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.32",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^9.0.3"
  }
}
